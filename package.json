{
  "name": "wotnt-ru",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/update-version.cjs && npm run cache:ensure && nuxt build",
    "dev": "npm run cache:ensure && nuxt dev --dotenv .env.local",
    "build:prod": "npm run cache:ensure && nuxt build --dotenv .env.production",
    "preview:prod": "nuxt preview --dotenv .env.production",
    "generate": "npm run cache:ensure && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "cache:ensure": "node scripts/cache.js ensure",
    "cache:clear": "node scripts/cache.js clear",
    "clear-cache": "npm run cache:clear",
    "dev:clean": "npm run cache:clear && npm run dev",
    "prebuild": "npm run cache:ensure"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/image": "^2.0.0",
    "@nuxt/scripts": "^0.13.2",
    "@nuxtjs/gtm": "^2.4.0",
    "@nuxtjs/robots": "^5.7.1",
    "@nuxtjs/sitemap": "^7.6.0",
    "@pinia/nuxt": "^0.11.3",
    "@qirolab/nuxt-sanctum-authentication": "^0.1.15",
    "@vueuse/core": "^14.2.1",
    "laravel-echo": "^2.3.7",
    "nuxt": "^4.5.1",
    "nuxt-gtag": "^4.1.0",
    "nuxt-swiper": "^2.0.1",
    "pinia": "^3.0.4",
    "pusher-js": "^8.5.0",
    "swiper": "^12.1.4",
    "uuid": "^14.0.0",
    "vue": "^3.5.28",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "puppeteer": "^24.42.0"
  }
}
