{
  "name": "Слово Истины",
  "short_name": "Слово Истины",
  "description": "Проповеди и события",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "minimal-ui", "standalone"],
  "orientation": "portrait",
  "theme_color": "#4f46e5",
  "background_color": "#4f46e5",
  "protocol_handlers": [
    {
      "protocol": "web+wotnt",
      "url": "/protocol/%s"
    },
    {
      "protocol": "mailto",
      "url": "/contact?email=%s"
    }
  ],
  "icons": [
    {
      "src": "/favicon/favicon-32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/favicon/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/favicon/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}